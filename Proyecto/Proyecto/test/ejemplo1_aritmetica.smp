// Programa de prueba 1: Aritmética, lógica y condicionales
// Este programa demuestra operaciones aritméticas y lógicas con estructuras de control

var x;
var y;
var resultado;

haz x 10;
haz y 5;

// Operaciones aritméticas
suma 2 3;
producto x y;
haz resultado 15;

mayorque? 6 8;



// Condicional simple
si (mayorque x y;)
[escribe x;]
[escribe y;]

