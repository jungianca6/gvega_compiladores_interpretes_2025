PARA estrellasRotadas []
    inic total = 5;          // cuántas estrellas
    inic giro = 360 / total;  // ángulo entre cada estrella
    inic i = 0;

    centro;
    bajalapiz;
    colorlapiz negro;
    ponrumbo 90;

    MIENTRAS (i < total) [

        estrella[];

        // rotamos la tortuga para la siguiente estrella
        gd giro;

        inc [i];
    ]

    subelapiz;
FIN

estrellasRotadas[];
